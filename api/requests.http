@baseUrl = http://localhost:5080

### Topics: list
GET {{baseUrl}}/topics

### Topics: get one (ETag: "1")
GET {{baseUrl}}/topics/3

### Topics: get a missing topic (404)
GET {{baseUrl}}/topics/999

### Topics: create (201, Location, ETag: "1")
POST {{baseUrl}}/topics
Content-Type: application/json

{
  "title": "Managing Users",
  "body": "Add, remove and change the roles of library users.",
  "tags": ["admin", "users"]
}

### Topics: create with validation errors (400, errors keyed title and tags[1])
POST {{baseUrl}}/topics
Content-Type: application/json

{
  "title": "",
  "tags": ["pdf", "PDF"]
}

### Topics: update with the current version (200, ETag: "2")
PUT {{baseUrl}}/topics/1
Content-Type: application/json
If-Match: "1"

{
  "title": "Introduction to Author-it",
  "body": "An updated overview of Author-it.",
  "tags": ["overview", "getting-started"]
}

### Topics: stale update, run after the one above (412, currentVersion 2, nothing changed)
PUT {{baseUrl}}/topics/1
Content-Type: application/json
If-Match: "1"

{
  "title": "Edited from an old copy",
  "body": "This edit was based on version 1.",
  "tags": ["overview"]
}

### Topics: update a missing topic without If-Match (404 wins over 428)
PUT {{baseUrl}}/topics/999
Content-Type: application/json

{
  "title": "Nowhere",
  "body": "",
  "tags": []
}

### Topics: update without If-Match (428)
PUT {{baseUrl}}/topics/1
Content-Type: application/json

{
  "title": "No precondition",
  "body": "",
  "tags": []
}

### Topics: usage report (200, 3 references across 2 books)
GET {{baseUrl}}/topics/3/usage

### Topics: usage of an unused topic (200, zero counts, empty books; run after creating a topic)
GET {{baseUrl}}/topics/6/usage

### Topics: usage of a missing topic (404)
GET {{baseUrl}}/topics/999/usage

### Books: list (200, no contents)
GET {{baseUrl}}/books

### Books: get one (200, with contents)
GET {{baseUrl}}/books/3

### Books: get a missing book (404)
GET {{baseUrl}}/books/999

### Books: create (201, Location /books/4, empty contents)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Release Notes",
  "description": "What changed in each release."
}

### Books: create with validation errors (400, errors keyed title)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "   ",
  "description": null
}

### References: add at a position (201, Location /books/1, later positions shift)
POST {{baseUrl}}/books/1/references
Content-Type: application/json

{
  "topicId": 5,
  "level": 1,
  "position": 2
}

### References: append (position omitted)
POST {{baseUrl}}/books/1/references
Content-Type: application/json

{
  "topicId": 5,
  "level": 1
}

### References: add to a missing book (404)
POST {{baseUrl}}/books/999/references
Content-Type: application/json

{
  "topicId": 1,
  "level": 1
}

### References: unknown topic (400, errors keyed topicId)
POST {{baseUrl}}/books/1/references
Content-Type: application/json

{
  "topicId": 99,
  "level": 1
}

### References: missing topicId and level (400, errors keyed topicId and level)
POST {{baseUrl}}/books/1/references
Content-Type: application/json

{}

### References: outline rule broken (400, errors keyed level)
POST {{baseUrl}}/books/1/references
Content-Type: application/json

{
  "topicId": 1,
  "level": 3
}

### References: position out of range (400, errors keyed position)
POST {{baseUrl}}/books/1/references
Content-Type: application/json

{
  "topicId": 1,
  "level": 1,
  "position": 50
}

### References: remove an entry with no descendants (204; reference 11 is the last entry of book 3)
DELETE {{baseUrl}}/books/3/references/11

### References: remove an entry with descendants (409, descendants lists reference 9)
DELETE {{baseUrl}}/books/3/references/8

### References: remove an entry and its descendants (204)
DELETE {{baseUrl}}/books/3/references/8?cascade=true

### References: reference belongs to another book (404)
DELETE {{baseUrl}}/books/1/references/8

### References: missing book (404)
DELETE {{baseUrl}}/books/999/references/8
